{
  "name": "intelli-wha",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent WhatsApp-first conversational commerce and media generation platform.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "check": "turbo check",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @intelli-wha/db db:generate",
    "db:migrate": "pnpm --filter @intelli-wha/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.8",
    "typescript": "^5.8.5",
    "vitest": "^4.1.5"
  }
}
